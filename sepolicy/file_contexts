# Binaries
/(vendor|system/vendor)/bin/cir_fw_update                                                     u:object_r:cir_fw_update_exec:s0
/(vendor|system/vendor)/blobs/(.*)/bin/netmgrd                                                u:object_r:netmgrd_exec:s0
/(vendor|system/vendor)/blobs/(.*)/bin/qmuxd                                                  u:object_r:qmuxd_exec:s0

# Binaries (recovery only)
/system/bin/chargeled                                                                u:object_r:charger_exec:s0

# Data files
/dev/socket/cam(/.*)?                                                                 u:object_r:camera_socket:s0
/data/vendor/mediadrm(/.*)?                                                         u:object_r:mediadrm_vendor_data_file:s0

# Sensors HAL calibration, reached through links at its hardcoded /data/misc paths
/data/misc/(cw_calibrator_mag\.ini|AccOffset\.txt)                                   u:object_r:sensors_data_file:s0
/data/vendor/sensors(/.*)?                                                           u:object_r:sensors_data_file:s0

# Debug
/sys/kernel/debug/ion/heaps/system                                                   u:object_r:debugfs_ion:s0

# Device nodes
/dev/radio                                                                           u:object_r:qcril_device:s0
/dev/rawchip(.*)                                                                     u:object_r:mm-qcamerad_device:s0
/dev/rfkill                                                                          u:object_r:rfkill_device:s0
/dev/rt5501                                                                          u:object_r:audio_device:s0
/dev/tfa9887                                                                         u:object_r:audio_device:s0
/dev/tfa9887l                                                                        u:object_r:audio_device:s0
/dev/ttyHSL2                                                                         u:object_r:cir_device:s0

# Device specific partitions
/dev/block/platform/msm_sdcc\.1/by-name/cdma_record                                  u:object_r:radio_config_device:s0
/dev/block/platform/msm_sdcc\.1/by-name/extra                                        u:object_r:metadata_block_device:s0
/dev/block/platform/msm_sdcc\.1/by-name/modem_st1                                    u:object_r:modem_efs_partition_device:s0
/dev/block/platform/msm_sdcc\.1/by-name/modem_st2                                    u:object_r:modem_efs_partition_device:s0
/dev/block/platform/msm_sdcc\.1/by-name/radio_config                                 u:object_r:radio_config_device:s0

# HALs
/(vendor|system/vendor)/bin/hw/android\.hardware\.gnss@1\.0-service\.legacy          u:object_r:hal_gnss_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.power-service-qti                     u:object_r:hal_power_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.wifi@1\.0-service\.legacy           u:object_r:hal_wifi_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.gatekeeper@1\.0-service\.software           u:object_r:hal_gatekeeper_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.light@2\.0-service\.htc_msm8974             u:object_r:hal_light_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.power\.stats@1\.0-service\.mock    u:object_r:hal_power_stats_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.lineage\.touch@1\.0-service\.htc_msm8974               u:object_r:hal_lineage_touch_default_exec:s0

# Same-process HALs mapped by every graphics client
/(vendor|system/vendor)/lib/hw/gralloc\.msm8974\.so                                   u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib/libmemalloc\.so                                           u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib/libsc-a3xx\.so                                            u:object_r:same_process_hal_file:s0

# TARGET_LD_SHIM_LIBS targets
/(vendor|system/vendor)/lib/hw/camera\.vendor\.msm8974\.so                            u:object_r:vendor_shim_target_file:s0
/(vendor|system/vendor)/lib/libril(_spr|_vzw)?-qc-qmi-1\.so                           u:object_r:vendor_shim_target_file:s0

# Vendor configuration the location, audio and IR blobs open under /etc
/system/etc/(flp|gps|izat|sap)\.conf                                                  u:object_r:vendor_configs_file:s0
/system/etc/[A-Za-z_]+_cal(_recovery)?\.acdb                                          u:object_r:vendor_configs_file:s0
/system/etc/cir\.img                                                                  u:object_r:vendor_configs_file:s0
/system/etc/tfa(/.*)?                                                                 u:object_r:vendor_configs_file:s0

# Rootfs files
/tombstones                                                                          u:object_r:rootfs:s0

# Sysfs nodes
/sys/devices/msm_sdcc\.1/mmc_host/mmc0/mmc0:[0-9a-f]+/block/mmcblk0/queue/discard_max_bytes   u:object_r:sysfs_devices_block:s0
/sys/android_camera([0-9]+)?/sensor                                                  u:object_r:sysfs_camera_sensor:s0
/sys/devices/f9925000\.i2c/i2c-1/1-[0-9a-f]+/leds/flashlight(/.*)?                   u:object_r:sysfs_flashlight:s0
/sys/devices/qpnp-bms-(.*)?/power_supply/bms(/.*)?                                   u:object_r:sysfs_battery_supply:s0
/sys/devices/qpnp-vadc-(.*)?/batt_therm                                              u:object_r:sysfs_thermal:s0
/sys/devices/qpnp-vadc-(.*)?/emmc_therm                                              u:object_r:sysfs_thermal:s0
