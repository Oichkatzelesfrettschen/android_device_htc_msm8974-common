# The haptic generator effect loads in the audio HAL and reads its gain.
get_prop(hal_audio_default, vendor_qti_probe_prop)

# libacdbloader in the audio HAL dumps the MBHC, ANC and MAD calibration it
# sends to the codec into /data/misc/audio. The codec reads its MBHC table
# from def_taiko_mbhc_cal and its ANC and MAD tables from wcd9320/ firmware,
# so the dump has no consumer; the platform owns audio_data_file and the
# neverallows keep vendor domains out of it.
dontaudit hal_audio_default audio_data_file:dir search;
