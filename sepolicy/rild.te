# Allow the daemon to access /dev/radio and create qcril.db there
allow rild qcril_device:dir rw_dir_perms;
allow rild qcril_device:file { create_file_perms ioctl };

allow rild vendor_shim_target_file:file { r_file_perms execute map };
get_prop(rild, system_prop)
get_prop(rild, vendor_qcom_data_prop)
get_prop(rild, vendor_qcril_prop)
get_prop(rild, vendor_rild_libpath_prop)
# SQLite probes F2FS_IOC_GET_FEATURES on qcril.db.
allowxperm rild qcril_device:file ioctl 0xf50c;

# libril-qc-qmi-1 probes /data/misc/radio/ril_log and
# validation_result_sub*.xml, debug outputs in a platform directory; RIL_Init
# completes without them.
dontaudit rild radio_core_data_file:dir search;
