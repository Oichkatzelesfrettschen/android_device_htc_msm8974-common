# Platform-side init actions for this device. Each one touches a path or
# property that vendor_init may not reach.

on post-fs-data
    # TWRP writes /cache/recovery/intent and last_log.gz with a context this
    # policy does not define; RecoverySystem deletes them once they carry
    # cache_recovery_file. --force bypasses the directory digest, which
    # records file_contexts and not the files TWRP adds.
    restorecon_recursive --force /cache/recovery

    # The sensors HAL opens its calibration files under /data/misc by
    # hardcoded path. The files live in /data/vendor/sensors; the links carry
    # htc_sensor_calibration_link; following a link reads vendor-owned data.
    symlink /data/vendor/sensors/cw_calibrator_mag.ini /data/misc/cw_calibrator_mag.ini
    symlink /data/vendor/sensors/AccOffset.txt /data/misc/AccOffset.txt
    restorecon /data/misc/cw_calibrator_mag.ini
    restorecon /data/misc/AccOffset.txt

    # Move persistent GNSS state before creating children. The final helper
    # call publishes readiness only after ownership and relabeling succeed.
    exec -- /system/bin/vold_prepare_subdirs migrate-vendor-data /data/misc/location /data/vendor/location
    restorecon_recursive --force /data/vendor/location
    exec -- /system/bin/vold_prepare_subdirs migrate-vendor-data /data/misc/location /data/vendor/location 0770 1021 1021 sys.htc.vendor_data.location.ready gpsone_d 0770 1000 1021 gsiff 0770 1021 1021 mq 0770 1021 1021 quipc 0770 1021 1000 xtwifi 0770 1021 1021

    # netmgrd writes fixed diagnostic children through its legacy directory.
    # Readiness follows migration, ownership validation and final relabeling.
    prepare_vendor_data /data/data_test /data/vendor/netmgr 0770 1001 1001 sys.htc.vendor_data.netmgr.ready

    # libmmcamera_imglib in mm-qcamera-daemon keeps its face album at
    # /data/fdAlbum by hardcoded path; the file lives in /data/vendor/camera.
    mkdir /data/vendor/camera 0770 camera camera
    symlink /data/vendor/camera/fdAlbum /data/fdAlbum
    restorecon /data/fdAlbum

    # time_daemon keeps its RTC offset in /data/time.
    mkdir /data/time 0700 system system

    # Compatibility links retain mpdecision's hardcoded paths; preparation
    # preserves existing data and holds startup on a directory conflict.
    exec -- /system/bin/vold_prepare_subdirs migrate-vendor-data /data/misc/perfd /data/vendor/perfd_socket
    restorecon_recursive --force /data/vendor/perfd_socket
    exec -- /system/bin/vold_prepare_subdirs migrate-vendor-data /data/misc/perfd /data/vendor/perfd_socket 2755 0 1000 sys.htc.vendor_data.perfd_socket.ready
    exec -- /system/bin/vold_prepare_subdirs migrate-vendor-data /data/system/perfd /data/vendor/perfd
    restorecon_recursive --force /data/vendor/perfd
    exec -- /system/bin/vold_prepare_subdirs migrate-vendor-data /data/system/perfd /data/vendor/perfd 2770 0 1000 sys.htc.vendor_data.perfd.ready

# The swcodec APEX carries a linker config that resolves its HAL clients
# through namespaces this device's legacy blobs do not satisfy; the system
# copy replaces it once apexd has activated the APEX.
on property:apexd.status=ready
    mount none /system/etc/swcodec/ld.config.txt /apex/com.android.media.swcodec/etc/ld.config.txt bind

# android.hardware.thermal-service.pixel.rc gates vendor.thermal-hal on
# vendor.thermal.link_ready=1, a Pixel thermal-driver-linking property this
# tsens-based board never sets; tsens is available as soon as the vendor
# partition mounts, so it is unconditionally ready.
on boot
    setprop vendor.thermal.link_ready 1
    setprop sys.htc.vendor_data.boot_ready 1

on property:sys.htc.vendor_data.boot_ready=1 && property:sys.htc.vendor_data.location.ready=1
    start vendor.gnss_service

# Preserve the core service boot gate while requiring prepared diagnostic data.
on property:sys.htc.vendor_data.boot_ready=1 && property:sys.htc.vendor_data.netmgr.ready=1
    start netmgrd

# The readiness properties are system-internal, so this trigger lives in a
# system init file; vendor_init cannot read them.
on property:dev.bootcomplete=1 && property:sys.htc.vendor_data.perfd.ready=1 && property:sys.htc.vendor_data.perfd_socket.ready=1
    rm /data/vendor/perfd/default_values
    start mpdecision
