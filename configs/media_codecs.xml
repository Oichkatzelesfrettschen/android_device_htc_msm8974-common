<MediaCodecs>
    <Include href="media_codecs_google_audio.xml" />
    <Include href="media_codecs_google_telephony.xml" />
    <Settings>
        <Setting name="max-video-encoder-input-buffers" value="9" />
    </Settings>
    <Encoders>
        <!-- Audio Hardware  -->
        <!--
             libOmxAacEnc.so, libOmxEvrcEnc.so and libOmxQcelp13Enc.so all
             abort with the identical bionic FORTIFY catch
             ("pthread_mutex_destroy called on a destroyed mutex") in their
             own destructor (omx_aac_aenc::~omx_aac_aenc(),
             omx_evrc_aenc::~omx_evrc_aenc(), and the qcelp13 equivalent),
             reached through qc_omx_component_deinit() -> OMX_FreeHandle().
             This fires during media.codec's own boot-time component
             enumeration (OMXStore::destroyComponentInstance() after a
             probe instantiation), independent of rank and independent of
             any real encode ever being requested. evidence/
             m8-tombstones-20260927/ holds ten crash captures, one per boot,
             alternating between the aac and evrc destructors. A rank
             changes runtime selection preference among several candidates;
             it does not stop the framework's boot-time probe from
             instantiating and destroying every declared component once.
             Removing the declaration is the only correct fix, not a rank.
             AAC keeps full capability through AOSP's own software encoder
             (media_codecs_google_c2_audio.xml); evrc and qcelp13 have no
             software equivalent in this tree, so this device loses EVRC/
             QCELP hardware encode. Both formats serve CDMA voice-call
             audio, which this device's carrier network (Sprint) shut down
             in 2022 (notes/DEVICE_STATE.md), so the capability has no
             reachable network to serve regardless.
        -->
        <!-- Audio Software  -->
        <!-- Video Hardware  -->
        <MediaCodec name="OMX.qcom.video.encoder.avc" type="video/avc" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-loaded-to-idle-after-allocation" />
            <Limit name="size" min="96x64" max="4096x2160" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="972000" />
            <Limit name="bitrate" range="1-100000000" />
            <Limit name="concurrent-instances" max="13" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.video.encoder.mpeg4" type="video/mp4v-es" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-loaded-to-idle-after-allocation" />
            <Limit name="size" min="96x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="244800" />
            <Limit name="bitrate" range="1-40000000" />
            <Limit name="concurrent-instances" max="13" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.video.encoder.h263" type="video/3gpp" >
